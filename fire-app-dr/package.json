{
  "name": "fire-business-app-unified",
  "version": "1.0.0-rc.138",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --port 5173",
    "build": "vinext build",
    "build:independent": "npm run build && node scripts/configure-independent-wrangler.mjs",
    "hash:password": "node scripts/hash-admin-password.mjs",
    "restore:records": "node scripts/restore-records-backup.mjs",
    "restore:photos": "node scripts/restore-photo-archive.mjs",
    "deploy:independent": "node ./node_modules/wrangler/bin/wrangler.js deploy --config dist/server/wrangler.independent.json",
    "start": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "preflight:independent": "node scripts/preflight-independent.mjs",
    "validate:backup": "node scripts/validate-records-backup.mjs",
    "release:readiness": "node scripts/release-readiness.mjs",
    "release:sync-check": "node scripts/check-unified-release.mjs",
    "release:strict-parity": "node scripts/strict-parity-gate.mjs",
    "parity:fixture:validate": "node scripts/validate-strict-parity-fixture.mjs",
    "parity:fixture:load": "npm run restore:records -- --backup fixtures/strict-parity-records.json",
    "parity:fixture:photos": "npm run restore:photos -- --archive fixtures/strict-parity-photos.zip",
    "parity:fixture:remove": "node scripts/remove-strict-parity-fixture.mjs",
    "release:parity-evidence": "node scripts/strict-parity-gate.mjs",
    "parity:capture-plan": "node scripts/capture-plan-gate.mjs",
    "parity:evidence:intake": "node scripts/parity-evidence-intake.mjs",
    "parity:evidence:files": "node scripts/verify-parity-evidence-files.mjs",
    "release:package-check": "node scripts/validate-release-package.mjs",
    "typecheck": "tsc --noEmit",
    "parity:evidence:register": "node scripts/register-parity-evidence.mjs",
    "parity:capture:queue": "node scripts/build-parity-capture-queue.mjs",
    "parity:evidence:compare": "node scripts/compare-parity-evidence.mjs",
    "parity:progress": "node scripts/build-parity-progress.mjs",
    "release:evidence-seal": "node scripts/build-release-evidence-seal.mjs",
    "release:evidence-seal:check": "node scripts/validate-release-evidence-seal.mjs",
    "release:package:build": "node scripts/build-release-package.mjs",
    "release:docs:check": "node scripts/validate-current-recovery-docs.mjs",
    "restore:verify-contract": "node scripts/validate-restore-verification.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
